---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { coverForSlug } from '../../lib/covers';
import { pickRelated } from '../../lib/related-posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const related = pickRelated(posts, post, 3);
const canonical = new URL(`/blog/${post.id}/`, Astro.site).href;
const coverImage = coverForSlug(post.id, post.data.cover_image);
const imageUrl = coverImage ? new URL(coverImage, Astro.site).href : undefined;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.created,
  dateModified: post.data.created,
  inLanguage: 'en-US',
  image: imageUrl
    ? { '@type': 'ImageObject', url: imageUrl }
    : undefined,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Organization', name: 'North Lane Pick', url: 'https://northlanepick.com' },
  publisher: {
    '@type': 'Organization',
    name: 'North Lane Pick',
    url: 'https://northlanepick.com',
  },
};

const clusterLabels: Record<string, string> = {
  'sunscreen-spf': 'Sunscreen & SPF',
  'skincare-routine': 'Skincare Routine',
};

const clusterLabel = post.data.cluster
  ? (clusterLabels[post.data.cluster] ?? post.data.cluster)
  : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://northlanepick.com/' },
    { '@type': 'ListItem', position: 2, name: post.data.title, item: canonical },
  ],
};

const formattedDate = post.data.created
  ? new Date(`${post.data.created}T12:00:00`).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : null;

---

<Base
  title={post.data.title}
  description={post.data.description}
  ogImage={coverImage}
  jsonLd={[articleLd, breadcrumbLd]}
  narrow
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      {
        clusterLabel && (
          <li>
            <span>{clusterLabel}</span>
          </li>
        )
      }
      <li>
        <span aria-current="page">{post.data.title}</span>
      </li>
    </ol>
  </nav>
  <header class="article-hero">
    <div class="article-hero__cover">
      <img src={coverImage} alt="" width="1200" height="630" decoding="async" />
    </div>
    <div class="article-hero__content">
      <div class="article-hero__meta">
        {clusterLabel && (
          <span
            class:list={[
              'cluster-pill',
              post.data.cluster === 'skincare-routine' && 'cluster-pill--routine',
            ]}
          >
            {clusterLabel}
          </span>
        )}
        {
          formattedDate && (
            <time class="post-card__date" datetime={post.data.created}>
              {formattedDate}
            </time>
          )
        }
      </div>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </div>
  </header>
  <article class="article-body">
    <Content />
  </article>
  {
    related.length > 0 && (
      <aside class="related-posts">
        <p class="section-label">Related guides</p>
        <h2 class="related-posts__heading">Keep reading</h2>
        <ul class="post-grid related-posts__grid">
          {related.map((item) => (
            <li>
              <PostCard
                href={`/blog/${item.id}/`}
                title={item.data.title}
                description={item.data.description}
                cluster={item.data.cluster}
                created={item.data.created}
                coverImage={coverForSlug(item.id, item.data.cover_image)}
              />
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</Base>
