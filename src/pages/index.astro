---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { coverForSlug } from '../lib/covers';

const posts = (await getCollection('blog')).sort((a, b) =>
  (b.data.created ?? '').localeCompare(a.data.created ?? '')
);
---

<Base title="North Lane Pick — Skincare & SPF Picks for US Shoppers">
  <section class="page-hero">
    <p class="section-label">Curated for US shoppers</p>
    <h1>Skincare &amp; SPF that fits real life</h1>
    <p class="lede">
      Bright, practical guides for sunscreen and daily skincare — what to keep,
      what to skip, and which Amazon picks are worth a click.
    </p>
  </section>

  <p class="section-label">Latest guides</p>
  <ul class="post-grid">
    {
      posts.map((post) => (
        <li>
          <PostCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            cluster={post.data.cluster}
            created={post.data.created}
            coverImage={coverForSlug(post.id, post.data.cover_image)}
          />
        </li>
      ))
    }
  </ul>
</Base>
